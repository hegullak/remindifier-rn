# Clerk (https://dashboard.clerk.com → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# OpenAI parsing proxy (Cloudflare Worker — see workers/parse-api/README.md)
# Dev: http://127.0.0.1:8787 after `npm run dev` in workers/parse-api
EXPO_PUBLIC_PARSE_API_URL=https://your-worker.workers.dev

# Google / Apple buttons in app (requires Clerk Pro + providers enabled in Dashboard)
# EXPO_PUBLIC_CLERK_OAUTH_ENABLED=true

# After enabling Google / Apple in Clerk Dashboard, add redirect URL:
#   <your-scheme>://sso-callback
# Dev (Expo Go) example — run once and copy from Metro / AuthSession.makeRedirectUri:
#   exp://192.168.x.x:8081/--/sso-callback
# Production (custom scheme in app.json):
#   remindifier-rn://sso-callback
