{
  "expo": {
    "name": "echoflow",
    "slug": "remindifier-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1E26"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hegullak.remindifier",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hegullak.remindifier",
      "adaptiveIcon": {
        "backgroundColor": "#1A1E26",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "scheme": "remindifier-rn",
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1E26",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow echoflow to scan QR codes to add people."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow echoflow to read your calendars for the daily brief, and to manage its own echoflow calendar. Your other calendars are never modified."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25bb96b3-9042-4ca1-95e7-03e8ee7088a8"
      }
    },
    "owner": "go4gullaksen"
  }
}
