{
  "expo": {
    "name": "echoflow",
    "slug": "remindifier-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1E26"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hegullak.remindifier",
      "supportsTablet": true
    },
    "android": {
      "package": "com.hegullak.remindifier",
      "adaptiveIcon": {
        "backgroundColor": "#1A1E26",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "remindifier-rn",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1E26",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow echoflow to scan QR codes to add people."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow echoflow to create a test calendar with seed events for development."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
